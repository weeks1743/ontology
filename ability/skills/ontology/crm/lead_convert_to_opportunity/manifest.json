      "severity": "high"
    },
    {
      "rule_code": "Lead.BudgetThreshold",
      "rule_name_zh": "线索预算门槛",
      "expression": {
        "type": "logical_or",
        "operands": [
          {
            "type": "comparison",
            "left": "lead.budget",
            "operator": ">=",
            "right": 10000
          },
          {
            "type": "is_null",
            "field": "lead.budget"
          }
        ]
