  "write_plan": {
    "mongodb": {
      "required": true,
      "ops": [
        {
          "op": "insert",
          "collection": "crm_leads",
          "alias": "lead_id",
          "document": {
            "id": "$result.lead_id"
          }
        },
        {
          "op": "insert",
          "collection": "crm_opportunities",
          "alias": "opportunity_id",
          "document": {
            "id": "$result.opportunity_id"
          }
        }
      ]
    },
    "neo4j": {
      "required": true,
      "ops": [
        {
          "op": "upsert_node",
          "label": "Lead",
          "id_field": "lead_id",
          "properties": {
            "id": "$result.lead_id",
            "ontology_id": "crm"
          }
        },
        {
          "op": "upsert_node",
          "label": "Opportunity",
          "id_field": "opportunity_id",
          "properties": {
            "id": "$result.opportunity_id",
            "ontology_id": "crm"
          }
        },
        {
          "op": "upsert_edge",
          "from_label": "Lead",
          "from_id": "$input.lead_id",
          "to_label": "Opportunity",
          "to_id": "$result.opportunity_id",
          "relationship": "CONVERTED_TO"
        }
      ]
    },
    "chroma": {
      "required": false,
      "ops": [
        {
          "op": "upsert",
          "collection": "crm_opportunities",
          "id": "$result.opportunity_id",
          "document": "$result.opportunity_title",
          "metadata": {
            "object_type": "Opportunity",
            "source": "converted"
          }
        }
      ]
    }
  },
